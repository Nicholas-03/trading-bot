+                price = round(1.0 - o.price if flip else o.price, dec)
+                on_bids = (o.side is Side.BUY) != flip
+                side = b.bids if on_bids else b.asks
+                if price in side:
+                    left = side[price] - o.size
+                    if left > 1e-6:
+                        side[price] = left
+                    else:
+                        del side[price]
