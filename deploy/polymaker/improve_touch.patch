+    def _book_without_own(self, yes_book: OrderBook, meta: MarketMeta) -> OrderBook:
+        """The YES book minus our resting orders (a NO order at q sits in the YES book at 1 - q, on the other side)."""
+        b = OrderBook(yes_book.tick_size)
+        b.bids, b.asks = SortedDict(yes_book.bids), SortedDict(yes_book.asks)
+        dec = meta.price_decimals
